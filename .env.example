# Sao chép thành .env rồi đổi giá trị. npm start, npm run demo, npm run token và docker compose đều đọc file này.
# Giá trị dưới đây chỉ là placeholder.

# Khóa ký JWT HS256. Bắt buộc khi NODE_ENV=production (image Docker đặt sẵn production).
# Sinh ngẫu nhiên: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Ghi audit log quyết định phân quyền ra stdout: off | deny | all
AUDIT_LOG=deny

# Cổng của API (npm start) và của server demo (npm run demo)
PORT=3000
DEMO_PORT=3100
