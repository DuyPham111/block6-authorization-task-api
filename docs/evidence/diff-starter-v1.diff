diff --git a/src/services/access.js b/src/services/access.js
new file mode 100644
index 0000000..c4fd482
--- /dev/null
+++ b/src/services/access.js
@@ -0,0 +1,25 @@
+// Phần dùng chung của PEP: nạp resource từ DB rồi áp dụng quyết định của PDP.
+const db = require('../db')
+const { decide } = require('../policy')
+const { notFound, forbidden } = require('../errors')
+
+// project luôn suy ra từ task đang lưu, không lấy projectId từ request.
+function loadTask(taskId) {
+  const task = db.findTask(taskId)
+  if (!task) throw notFound()
+  return { task, project: db.findProject(task.projectId) }
+}
+
+function loadProject(projectId) {
+  const project = db.findProject(projectId)
+  if (!project) throw notFound()
+  return { project }
+}
+
+function enforce(user, action, resource) {
+  const decision = decide(user, action, resource)
+  if (!decision.allow) throw decision.visible ? forbidden() : notFound()
+  return decision
+}
+
+module.exports = { loadTask, loadProject, enforce }
diff --git a/src/services/taskService.js b/src/services/taskService.js
new file mode 100644
index 0000000..7d075cf
--- /dev/null
+++ b/src/services/taskService.js
@@ -0,0 +1,18 @@
+// PEP cho task: mọi entry point (route, job, export) đọc task qua service này.
+const db = require('../db')
+const { loadTask, loadProject, enforce } = require('./access')
+
+function getTask(user, taskId) {
+  const resource = loadTask(taskId)
+  enforce(user, 'task:read', resource)
+  return resource.task
+}
+
+// Một quyết định cho cả project thay vì kiểm từng task (tránh N+1 truy vấn quyền).
+function listProjectTasks(user, projectId) {
+  const resource = loadProject(projectId)
+  enforce(user, 'task:read', resource)
+  return db.listTasksByProject(projectId)
+}
+
+module.exports = { getTask, listProjectTasks }
